{
  "name": "digital-school-timetable",
  "productName": "الجدول المدرسي الرقمي",
  "version": "1.0.0",
  "description": "الجدول المدرسي الرقمي - توليد وإدارة الجداول المدرسية",
  "main": "electron-main.js",
  "author": "School",
  "scripts": {
    "vendor": "node -e \"require('fs').mkdirSync('vendor',{recursive:true});require('fs').copyFileSync('node_modules/xlsx/dist/xlsx.full.min.js','vendor/xlsx.full.min.js')\"",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "kw.school.digital-timetable",
    "productName": "الجدول المدرسي الرقمي",
    "files": [
      "index.html",
      "app.js",
      "manifest.json",
      "icon.svg",
      "icon.png",
      "sw.js",
      "vendor/**",
      "electron-main.js"
    ],
    "win": {
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "الجدول المدرسي الرقمي",
      "artifactName": "DigitalTimetable-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DigitalTimetable-Portable-${version}.${ext}"
    }
  }
}